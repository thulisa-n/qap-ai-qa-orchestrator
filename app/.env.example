GEMINI_API_KEY=your_key_here
# Stable Gemini Flash model code (Google AI Studio, November 2026).
# google-genai sends this as models/gemini-3.8-flash. Promptfoo uses google:gemini-3.8-flash.
# gemini-2.5-flash is deprecated and is removed from AI Studio.
GEMINI_MODEL=gemini-3.8-flash
API_AUTH_TOKEN=replace_with_long_random_token
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_token
JIRA_PROJECT_KEY=QAP
JOB_STORE_BACKEND=sqlite
JOB_DB_PATH=app/.data/jobs.db
# Opt-in DynamoDB Local. Dummy credentials only. Do not put real AWS keys here.
# JOB_STORE_BACKEND=dynamodb
# DYNAMODB_ENDPOINT=http://127.0.0.1:8001
# DYNAMODB_TABLE=qap-store
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local

